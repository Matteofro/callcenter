# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Pooled connection (used by the app at runtime — REQUIRED on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
# Direct connection (used by Prisma migrations, NOT pooled)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"

# ─── Logistics webhook ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
LOGISTICS_WEBHOOK_SECRET="change-me-in-production"
# Max age (seconds) for the webhook timestamp before we reject as replay
LOGISTICS_WEBHOOK_MAX_AGE_SECONDS="300"

# ─── App config ──────────────────────────────────────────────────────────────
DEFAULT_PHONE_COUNTRY="IT"
NODE_ENV="development"
